# supplier_scraper configuration. Copy what you need into the project .env.

# --- Bright Data: Scraping Browser (gated/interactive supplier sites) ---
# From the Browser API zone "Overview" tab in the Bright Data dashboard.
# Format: brd-customer-<customer_id>-zone-<zone_name>:<password>
BRIGHTDATA_BROWSER_AUTH=brd-customer-xxxx-zone-scraping_browser:xxxxxxxx
# Defaults are correct for Bright Data; override only if told to.
BRIGHTDATA_BROWSER_HOST=brd.superproxy.io
BRIGHTDATA_BROWSER_PORT=9222

# --- Bright Data: Web Unlocker (public/static supplier catalogs) ---
BRIGHTDATA_API_TOKEN=your_bright_data_api_token
BRIGHTDATA_UNLOCKER_ZONE=your_web_unlocker_zone_name
# BRIGHTDATA_UNLOCKER_ENDPOINT=https://api.brightdata.com/request

# --- Gemini (extraction) ---
# Already present for the ADK agent; reused here.
GOOGLE_API_KEY=your_google_api_key
# Optional model override (default gemini-2.5-flash-lite).
# GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# --- Per-supplier login credentials (only for gated suppliers) ---
AVASAM_EMAIL=
AVASAM_PASSWORD=
