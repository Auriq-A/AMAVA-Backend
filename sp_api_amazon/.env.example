# Amazon SP-API credentials for sp_api_amazon.
# Copy the values you need into the project .env (do NOT commit real secrets).

# --- Required: LWA app + seller refresh token ---
SPAPI_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxx
SPAPI_LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxx
SPAPI_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxx

# --- Optional ---
# Default marketplace (short name like US/UK/DE, country code, or raw id).
SPAPI_MARKETPLACE=US
# Selling-partner / merchant token. Required only by the Listings Items API.
SPAPI_SELLER_ID=
# Use the SP-API sandbox hosts instead of production (true/false).
SPAPI_SANDBOX=false

# --- Optional: only if you explicitly enable SigV4 signing (use_sigv4=True). ---
# Modern SP-API does NOT require these.
SPAPI_AWS_ACCESS_KEY_ID=
SPAPI_AWS_SECRET_ACCESS_KEY=
SPAPI_ROLE_ARN=
